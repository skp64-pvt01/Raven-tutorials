<?xml version="1.0" encoding="UTF-8"?>
<!--
  Raven tutorial 05 - the same interface, written in XML.

  A tag is a widget. An attribute is a property, and the ones starting with
  "Slot." are the slot of that widget in its parent (the same values the C
  functions set).

  Name="..." is how the code finds a widget again: Rwidget_find(window, "name").

  OnClicked="app.greet" does not call a function of the program directly: it
  fires the *action* named app.greet, which the program binds with
  Raction_bind("app.greet", ...). A menu item or a shortcut can fire it too.
-->
<Window Title="Tutorial 05 - XML interface" Width="520" Height="380" MinWidth="380" MinHeight="260">
	<VBox Spacing="10" Slot.Padding="24">
		<Label Text="Interface in XML" TextSize="22"/>
		<Label Text="The window, its layout and its texts are in this file; the program only fills in the code."
			Opacity="0.7"/>
		<Separator/>
		<Label Text="Your name"/>
		<TextInput Name="name" Placeholder="Type a name"/>
		<Button Name="greet" Text="Greet" Style="Primary" Slot.HAlign="Left" OnClicked="app.greet"/>
		<Label Name="greeting" Text="Hello!" TextSize="18" Slot.HAlign="Center"/>
	</VBox>
</Window>
