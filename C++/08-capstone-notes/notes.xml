<?xml version="1.0" encoding="UTF-8"?>
<!--
  Raven tutorial 08 - starting point for a real application.

  CustomHeader="true" replaces the title bar of the system with the HeaderBar
  below it: the bar is a widget, so the menus live in it. Dragging the bar moves
  the window, the edges still resize it.

  Every OnClicked="x.y" here is an action the program binds with Raction_bind.
  Shortcut="Ctrl+..." is handled by the menu item: the shortcut works with the
  menu closed, and shows in the menu.
-->
<Window Title="Notes" Width="900" Height="600" MinWidth="520" MinHeight="320" CustomHeader="true">
	<VBox>
		<HeaderBar Name="header">
			<MenuBar>
				<Menu Text="File">
					<MenuItem Text="New" Shortcut="Ctrl+N" OnClicked="file.new"/>
					<MenuItem Text="Open..." Shortcut="Ctrl+O" OnClicked="file.open"/>
					<Separator/>
					<MenuItem Text="Save" Shortcut="Ctrl+S" OnClicked="file.save"/>
					<MenuItem Text="Save as..." Shortcut="Ctrl+Shift+S" OnClicked="file.save_as"/>
					<Separator/>
					<MenuItem Text="Quit" Shortcut="Ctrl+Q" OnClicked="file.quit"/>
				</Menu>
				<Menu Text="Edit">
					<MenuItem Text="Undo" Shortcut="Ctrl+Z" OnClicked="edit.undo"/>
					<MenuItem Text="Redo" Shortcut="Ctrl+Shift+Z" OnClicked="edit.redo"/>
					<Separator/>
					<MenuItem Text="Select all" Shortcut="Ctrl+A" OnClicked="edit.select_all"/>
				</Menu>
				<Menu Text="View">
					<MenuItem Name="view.numbers" Text="Line numbers" Checkable="true" Checked="true"
						OnClicked="view.numbers"/>
					<MenuItem Name="view.wrap" Text="Word wrap" Checkable="true" OnClicked="view.wrap"/>
					<Separator/>
					<MenuItem Text="Dark" OnClicked="view.dark"/>
					<MenuItem Text="Light" OnClicked="view.light"/>
				</Menu>
			</MenuBar>
		</HeaderBar>

		<TextEditor Name="editor" LineNumbers="true" Wrap="true" Slot.Fill="1"
			Placeholder="Type here, open a file (Ctrl+O), or drop one on the window."/>

		<Separator/>
		<HBox Spacing="16" Slot.Padding="10,4">
			<Label Name="status" Slot.Fill="1" Opacity="0.8"/>
			<Label Name="position" Opacity="0.6"/>
		</HBox>
	</VBox>
</Window>
