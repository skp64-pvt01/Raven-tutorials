<?xml version="1.0" encoding="UTF-8"?>
<!--
  Raven tutorial 05 (Rust) - the interface, written in XML.

  A tag is a widget; an attribute is a property, and the ones starting with
  "Slot." are the slot of that widget in its parent.

  Name="..." is how Rust finds a widget again: widget_find(window, "name").

  OnClicked="app.greet" fires the *action* app.greet, which the program binds
  with action_bind("app.greet", ...). Nothing in this file knows Rust.
-->
<Window Title="Tutorial 05 - XML interface" Width="520" Height="380" MinWidth="380" MinHeight="260">
	<VBox Spacing="10" Slot.Padding="24">
		<Label Text="Interface in XML" TextSize="22"/>
		<Label Text="The window, its layout and its texts are in this file; Rust only fills in the code."
			Opacity="0.7"/>
		<Separator/>
		<Label Text="Your name"/>
		<TextInput Name="name" Placeholder="Type a name"/>
		<Button Name="greet" Text="Greet" Style="Primary" Slot.HAlign="Left" OnClicked="app.greet"/>
		<Label Name="greeting" Text="Hello!" TextSize="18" Slot.HAlign="Center"/>
	</VBox>
</Window>
